# Notion

## Integration 토큰
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

## 사전 알람 데이터소스 ID
NOTION_SUBSCRIBE_DATA_SOURCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

## 필요서류 데이터소스 ID
NOTION_DOCS_DATA_SOURCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

OCTOMO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OTP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase claims 저장 (대리청구 신청) — 서버 전용. VITE_ 접두사를 붙이면 브라우저 번들에 들어가므로 절대 금지
# SUPABASE_URL 은 VITE_SUPABASE_URL 과 같은 값이지만 이름을 따로 둔다 (서버 코드가 VITE_ 변수를 읽지 않게)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# 대시보드 API Keys의 Secret key(sb_secret_…) 또는 legacy service_role JWT
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# 슬랙 Incoming Webhook — 접수 알림 1통. 없으면 알림만 건너뛰고 저장은 된다
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# Gemini 영수증 OCR (api/analyze-receipt)
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-3-flash-preview
