# Notion

## Integration 토큰
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

## 사전 알람 데이터소스 ID
NOTION_SUBSCRIBE_DATA_SOURCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

## 필요서류 데이터소스 ID
NOTION_DOCS_DATA_SOURCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Solapi (SMS 발송)

## API 키 / 시크릿
SOLAPI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
SOLAPI_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

## 발신번호 (Solapi 콘솔에 사전 등록 필요)
SOLAPI_SENDER_NUMBER=01000000000

# 전화번호 인증 (OTP)

## 인증 토큰 서명용 비밀키 (32바이트 이상 랜덤 문자열 권장)
OTP_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
