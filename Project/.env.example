# Notion

## Integration 토큰
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

## 필요서류 데이터소스 ID
NOTION_DOCS_DATA_SOURCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Supabase — 프로젝트 하나. VITE_ 접두사가 붙은 값은 브라우저 번들에 들어간다 (URL·publishable 키는 공개돼도 된다)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

## 서버 전용 (api/claims · vite dev 미들웨어). VITE_ 를 붙이지 않는다 — secret key 는 RLS 를 우회한다. URL 은 위 VITE_SUPABASE_URL 을 같이 쓴다

## 대시보드 API Keys 의 Secret key (sb_secret_…) 또는 legacy service_role JWT
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Slack — Incoming Webhook. 접수 알림 1통. 없으면 알림만 건너뛰고 저장은 된다
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# Gemini — 영수증 OCR (api/analyze-receipt)
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-3-flash-preview
